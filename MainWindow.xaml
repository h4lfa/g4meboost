<Window x:Class="G4meBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:G4meBoost.Converters"
        Title="G4meB∞st" Width="820" Height="620"
        MinWidth="700" MinHeight="500"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0"
                      ResizeBorderThickness="5" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:LocConverter x:Key="Loc"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StrToVis"/>
    </Window.Resources>

    <Border BorderBrush="#30363D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════ TITLE BAR ═══════════════════ -->
            <Grid Grid.Row="0" Background="#161B22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="⬡" Foreground="#00B4D8" FontSize="18" FontWeight="Bold"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="G4meB∞st" Foreground="#E6EDF3" FontWeight="Bold"
                               FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" Foreground="#7D8590" FontSize="11"
                               Margin="8,2,0,0" VerticalAlignment="Center"/>
                    <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                            Cursor="Hand" ToolTip="GitHub: h4lfa" MouseLeftButtonDown="OnAuthorClick">
                        <TextBlock Text="by h4lfa" Foreground="#00B4D8" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="{Binding LangButtonText}" Style="{StaticResource LangButtonStyle}"
                            Command="{Binding ToggleLangCommand}" Margin="0,0,8,0"/>
                    <Button Content="─" Style="{StaticResource IconButtonStyle}" Click="OnMinimize"/>
                    <Button x:Name="MaxBtn" Content="□" Style="{StaticResource IconButtonStyle}" Click="OnMaximize"/>
                    <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════ CONTENT ═══════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16,20,16">

                    <!-- ── Mode Toggle Card ── -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModeTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="#E6EDF3"/>
                                <TextBlock Text="{Binding ModeStatus}" FontSize="13"
                                           Foreground="#7D8590" Margin="0,6,0,0"/>
                            </StackPanel>

                            <ToggleButton Grid.Column="1" Style="{StaticResource BigToggleSwitchStyle}"
                                          IsChecked="{Binding IsGamingMode}" VerticalAlignment="Center"
                                          Margin="16,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ── Category Tabs ── -->
                    <Border Background="#161B22" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Categories"
                                                 Content="{Binding DisplayName}"
                                                 IsChecked="{Binding IsSelected}"
                                                 Style="{StaticResource TabButtonStyle}"
                                                 Command="{Binding DataContext.SelectCategoryCommand,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- ── Optimization Items ── -->
                    <ItemsControl ItemsSource="{Binding CurrentItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NameKey, Converter={StaticResource Loc}}"
                                                       Foreground="#E6EDF3" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource Loc}}"
                                                       Foreground="#7D8590" FontSize="12" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#DA3633" FontSize="11"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding Status, Converter={StaticResource StrToVis}}"/>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                      IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                                      Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Info Note ── -->
                    <Border Background="#1A21262D" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ" Foreground="#00B4D8" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RequiresRebootText}" Foreground="#7D8590" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════ STATUS BAR ═══════════════════ -->
            <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusText}" Foreground="#7D8590" FontSize="12"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"
                               ToolTip="https://github.com/h4lfa" MouseLeftButtonDown="OnAuthorClick">
                        <Run Text="by" Foreground="#7D8590" FontSize="11"/>
                        <Run Text="h4lfa" Foreground="#00B4D8" FontWeight="SemiBold" FontSize="11"/>
                    </TextBlock>

                    <Button Grid.Column="2" Content="{Binding RestorePointText}"
                            Style="{StaticResource AccentButtonStyle}" Padding="12,4"
                            FontSize="11" Command="{Binding CreateRestorePointCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
